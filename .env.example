# Sanity CMS
# Project ID and dataset are public — they identify which Sanity project/dataset
# to read from and are safe to expose to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API version, in YYYY-MM-DD format. Pin this to a fixed date so
# schema/API behavior doesn't change unexpectedly.
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only Sanity API token. Used for authenticated/write operations
# (e.g. draft previews, revalidation webhooks). NEVER prefix this with
# NEXT_PUBLIC_ — it must not be exposed to the browser.
SANITY_API_TOKEN=

# Public site URL, used for metadata (canonical URLs, Open Graph, sitemap,
# robots.txt). Should not have a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
